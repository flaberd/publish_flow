# Template for the persistent production .env that lives on the EC2 host at
# /opt/publish-flow/.env — see docs/deployment.md ("Initial EC2 setup").
#
# This file itself is safe to commit (placeholders only). The real .env is
# created once on EC2 and is NEVER copied, generated or overwritten by the
# deploy pipeline or by the Docker image.
#
# Docker Compose loads this file two different ways:
#  - Laravel containers (app/queue/scheduler) via `env_file:` -> becomes the
#    container's environment, which Laravel reads as usual.
#  - The mysql container also reads it via `env_file:` for its own bootstrap
#    variables (MYSQL_*), which must be kept in sync with the DB_* values
#    below by hand (Compose does not do this for you).

APP_NAME=publish_flow
APP_ENV=production
# Generate locally with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Containers log to stdout/stderr (`docker compose logs`) instead of a file
# under storage/logs, so nothing there needs to be persisted or rotated by
# hand.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=publish_flow
DB_USERNAME=publish_flow
DB_PASSWORD=

# Must match DB_DATABASE / DB_USERNAME / DB_PASSWORD above — read by the
# mysql container's own bootstrap, not by Laravel.
MYSQL_DATABASE=publish_flow
MYSQL_USER=publish_flow
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# No Redis in this stack: sessions/cache/queue all use the `database` driver
# so nothing needs a 4th stateful service.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
# Leave unset for a single-domain app — Laravel uses the current request
# host automatically. Setting this to a fixed value that doesn't exactly
# match the domain you're actually serving makes the browser silently
# refuse the session cookie: login "succeeds" but every next request
# looks logged-out again.
# SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# From the Instagram product's "API setup with Instagram Login" page in your
# Meta App dashboard (developers.facebook.com). The redirect URI to register
# there is {APP_URL}/instagram/callback.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
